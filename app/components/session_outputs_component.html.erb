<section class="mb-6 rounded-lg border border-border bg-surface p-4 text-sm">
  <h2 class="mb-3 text-xs font-semibold tracking-widest text-muted uppercase">Outputs</h2>
  <dl class="grid grid-cols-2 gap-x-3 gap-y-3">
    <% outputs.each do |label, value| %>
      <div>
        <dt class="text-xs text-muted"><%= label %></dt>
        <dd class="font-mono text-lg font-medium text-ink"><%= value %></dd>
      </div>
    <% end %>
  </dl>
</section>
