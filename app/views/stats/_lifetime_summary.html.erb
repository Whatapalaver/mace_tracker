<%# locals: (stats:, period:, period_form_url:, period_hidden_params:, exercise: nil) %>
<section class="mb-6 grid grid-cols-2 gap-3">
  <div class="rounded-lg border border-border bg-surface p-4 text-center">
    <p class="font-mono text-2xl font-semibold text-ink"><%= stats.total_reps %></p>
    <p class="text-xs text-muted">Total reps</p>
  </div>
  <div class="rounded-lg border border-border bg-surface p-4 text-center">
    <p class="font-mono text-2xl font-semibold text-ink"><%= stats.total_volume.round %></p>
    <p class="text-xs text-muted">Total volume (kg)</p>
  </div>
</section>

<%= form_with url: period_form_url, method: :get, class: "mb-3",
      data: { turbo: false, controller: "scroll-preserving-form" } do %>
  <% period_hidden_params.each do |name, value| %>
    <%= hidden_field_tag name, value %>
  <% end %>
  <fieldset class="flex gap-4 text-sm">
    <legend class="sr-only">Time period</legend>
    <% Progression::LifetimeStats::PERIODS.each do |option| %>
      <label class="flex items-center gap-1">
        <%= radio_button_tag :period, option, period == option, class: "accent-rust",
              data: { action: "change->scroll-preserving-form#submit" } %>
        <%= option.capitalize %>
      </label>
    <% end %>
  </fieldset>
<% end %>

<section class="mb-6 rounded-lg border border-border bg-surface p-4 text-sm">
  <h2 class="mb-2 text-xs font-semibold tracking-widest text-muted uppercase">Reps by period</h2>
  <% if stats.reps_by_period.empty? %>
    <p class="text-sm text-muted">No sets logged yet.</p>
  <% else %>
    <%= column_chart stats.reps_by_period, xtitle: "Date", ytitle: "Total reps", colors: [ "#b5432b" ] %>
  <% end %>
</section>

<section class="mb-6 rounded-lg border border-border bg-surface p-4 text-sm">
  <h2 class="mb-2 text-xs font-semibold tracking-widest text-muted uppercase">Volume by period</h2>
  <% if stats.volume_by_period.empty? %>
    <p class="text-sm text-muted">No sets logged yet.</p>
  <% else %>
    <%= column_chart stats.volume_by_period, xtitle: "Date", ytitle: "Total volume (kg)", colors: [ "#a9793c" ] %>
  <% end %>
</section>

<% if exercise %>
  <% max_reps_series = stats.max_reps_by_weight_and_period %>
  <section class="mb-6 rounded-lg border border-border bg-surface p-4 text-sm">
    <h2 class="mb-2 text-xs font-semibold tracking-widest text-muted uppercase">Max reps by weight</h2>
    <% if max_reps_series.empty? %>
      <p class="text-sm text-muted">No sets logged yet.</p>
    <% else %>
      <%= line_chart max_reps_series.map { |name, data| { name: name, data: data } },
            xtitle: "Date", ytitle: "Max reps", colors: [ "#b5432b", "#a9793c", "#4b6b3a", "#6b6259" ] %>
    <% end %>
  </section>
<% end %>

