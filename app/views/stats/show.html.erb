<% content_for :title, "Lifetime Stats" %>

<h1 class="mb-4 text-xl font-semibold">Lifetime Stats</h1>

<%= form_with url: stats_path, method: :get, class: "mb-4" do |form| %>
  <%= form.label :exercise_id, "Exercise", class: "mb-1 block text-sm font-medium" %>
  <%= form.collection_select :exercise_id, @exercises, :id, :name,
        { include_blank: "All exercises", selected: @exercise&.id },
        class: "w-full rounded-md border-gray-300 px-3 py-2 text-base", onchange: "this.form.requestSubmit()" %>
<% end %>

<section class="mb-6 grid grid-cols-2 gap-3">
  <div class="rounded-lg border border-gray-200 bg-white p-4 text-center">
    <p class="text-2xl font-semibold"><%= @stats.total_reps %></p>
    <p class="text-xs text-gray-500">Total reps</p>
  </div>
  <div class="rounded-lg border border-gray-200 bg-white p-4 text-center">
    <p class="text-2xl font-semibold"><%= @stats.total_volume.round %></p>
    <p class="text-xs text-gray-500">Total volume (kg)</p>
  </div>
</section>

<section class="mb-6 rounded-lg border border-gray-200 bg-white p-4 text-sm">
  <h2 class="mb-2 font-semibold">Cumulative reps</h2>
  <% if @stats.cumulative_reps_by_date.empty? %>
    <p class="text-sm text-gray-500">No sets logged yet.</p>
  <% else %>
    <%= area_chart @stats.cumulative_reps_by_date, xtitle: "Date", ytitle: "Total reps" %>
  <% end %>
</section>

<section class="mb-6 rounded-lg border border-gray-200 bg-white p-4 text-sm">
  <h2 class="mb-2 font-semibold">Cumulative volume</h2>
  <% if @stats.cumulative_volume_by_date.empty? %>
    <p class="text-sm text-gray-500">No sets logged yet.</p>
  <% else %>
    <%= area_chart @stats.cumulative_volume_by_date, xtitle: "Date", ytitle: "Total volume (kg)" %>
  <% end %>
</section>
