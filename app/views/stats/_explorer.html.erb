<%# locals: (url:) %>
<% if @exercise_locked %>
  <p class="mb-6 text-sm">
    <span class="text-xs font-semibold tracking-widest text-muted uppercase">Exercise</span><br>
    <span class="font-medium"><%= @exercise.display_name %></span>
  </p>
<% else %>
  <%= form_with url: url, method: :get, class: "mb-6 space-y-4",
        data: { turbo: false, controller: "scroll-preserving-form" } do |form| %>
    <div>
      <%= form.label :equipment_id, "Equipment", class: "mb-1 block text-sm font-medium" %>
      <%= form.select :equipment_id, grouped_options_for_select(Equipment.filter_options, @equipment_filter),
            { include_blank: "All equipment" },
            class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base",
            data: { action: "change->scroll-preserving-form#submit" } %>
    </div>

    <div>
      <%= form.label :exercise_id, "Exercise", class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :exercise_id, @exercises, :id, :display_name,
            { include_blank: "All exercises", selected: @exercise&.id },
            class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base",
            data: { action: "change->scroll-preserving-form#submit" } %>
    </div>
  <% end %>
<% end %>

<% if @exercise && @personal_bests.any? %>
  <section class="mb-6 rounded-lg border border-border bg-surface p-4 text-sm">
    <h2 class="mb-2 text-xs font-semibold tracking-widest text-muted uppercase">Personal bests</h2>
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="text-xs text-muted">
          <th class="pb-1 font-medium">Weight</th>
          <th class="pb-1 font-medium">Max reps</th>
          <th class="pb-1 font-medium">Date</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% @personal_bests.each do |pb| %>
          <tr>
            <td class="py-1 font-mono"><%= pb[:weight] %>kg</td>
            <td class="py-1 font-mono"><%= pb[:reps] %></td>
            <td class="py-1 text-muted"><%= pb[:date].to_fs(:long) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<%= render "stats/lifetime_summary", stats: @stats, period: @period, period_form_url: url,
      period_hidden_params: { exercise_id: @exercise&.id, equipment_id: @equipment_filter }, exercise: @exercise %>

<% if @exercise %>
  <%= form_with url: url, method: :get, class: "mb-6 space-y-4",
        data: { turbo: false, controller: "scroll-preserving-form" } do |form| %>
    <%= hidden_field_tag :equipment_id, @equipment_filter %>
    <%= hidden_field_tag :exercise_id, @exercise.id %>

    <div>
      <%= label_tag :shape, "Shape", class: "mb-1 block text-sm font-medium" %>
      <%= select_tag :shape,
            options_for_select(@session_shapes.map { |shape| [ shape.label, shape.name ] }, @shape&.name),
            include_blank: "Choose a shape to browse progression",
            class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base",
            data: { action: "change->scroll-preserving-form#submit" } %>
    </div>

    <% if @shape&.name == SessionShape::INTERVAL_WORK %>
      <fieldset class="flex gap-4 text-sm">
        <legend class="sr-only">Signature granularity</legend>
        <label class="flex items-center gap-1">
          <%= radio_button_tag :granularity, "full", @granularity == "full", class: "accent-rust",
                data: { action: "change->scroll-preserving-form#submit" } %>
          Full signature
        </label>
        <label class="flex items-center gap-1">
          <%= radio_button_tag :granularity, "segment", @granularity == "segment", class: "accent-rust",
                data: { action: "change->scroll-preserving-form#submit" } %>
          Set duration only
        </label>
      </fieldset>
    <% end %>

    <% if @shape %>
      <div>
        <%= label_tag :structural_value, "Signature", class: "mb-1 block text-xs font-semibold tracking-widest text-muted uppercase" %>
        <%= select_tag :structural_value,
              options_for_select(@signatures.map { |signature| [ signature[:label], signature[:value] ] }, @structural_value),
              include_blank: "Choose a signature",
              class: "w-full rounded-md border border-ink bg-ink px-3 py-2 font-mono text-base text-paper",
              data: { action: "change->scroll-preserving-form#submit" } %>
      </div>
    <% end %>

    <% if @structural_value %>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= label_tag :weight, "Weight", class: "mb-1 block text-sm font-medium" %>
          <%= select_tag :weight,
                options_for_select([ [ "All weights", "" ] ] + @weights.map { |weight| [ "#{weight}kg", weight ] }, @weight),
                class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base",
                data: { action: "change->scroll-preserving-form#submit" } %>
        </div>
        <div>
          <%= label_tag :output, "Output", class: "mb-1 block text-sm font-medium" %>
          <%= select_tag :output, options_for_select(@output_labels, @output_label),
                class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base",
                data: { action: "change->scroll-preserving-form#submit" } %>
        </div>
      </div>

      <label class="flex items-center gap-2 text-sm font-medium">
        <%= check_box_tag :benchmarks_only, "true", @benchmarks_only, class: "accent-brass",
              data: { action: "change->scroll-preserving-form#submit" } %>
        Benchmarks only
      </label>
    <% end %>
  <% end %>
<% end %>

<% if @series %>
  <% output_label_with_unit =
       if @output_label.match?(/pace/i)
         "#{@output_label} (reps/min)"
       elsif @output_label.match?(%r{output / \w+ time}i)
         "#{@output_label} (kg/min)"
       else
         @output_label
       end %>
  <section class="mb-6 rounded-lg border border-border bg-surface p-4 text-sm">
    <h2 class="mb-2 text-xs font-semibold tracking-widest text-muted uppercase"><%= output_label_with_unit %></h2>
    <% if @series.values.all?(&:empty?) %>
      <p class="text-sm text-muted">No data yet for this signature.</p>
    <% else %>
      <%= line_chart @series.map { |name, data| { name: name, data: data } },
            xtitle: "Date", ytitle: output_label_with_unit, colors: chart_colors %>
    <% end %>
  </section>
<% end %>
