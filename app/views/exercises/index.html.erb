<% content_for :title, "Exercises" %>

<div class="mb-4 flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight">Exercises</h1>
  <%= link_to "Add exercise", new_exercise_path, class: "text-sm font-medium text-rust hover:text-rust-dark" %>
</div>

<% if @exercises.empty? %>
  <p class="text-sm text-muted">No exercises yet. Add one to start logging sessions.</p>
<% else %>
  <ul class="divide-y divide-border rounded-lg border border-border bg-surface">
    <% @exercises.each do |exercise| %>
      <% session_count = exercise.sessions.count %>
      <li class="flex items-center justify-between gap-3 px-4 py-3">
        <span><%= exercise.equipment.name %> <%= exercise.name %></span>
        <div class="flex items-center gap-3">
          <span class="text-xs text-muted"><%= exercise.arm_label %></span>
          <%= link_to "Edit", edit_exercise_path(exercise), class: "text-sm font-medium text-rust hover:text-rust-dark" %>
          <%= button_to "Delete", exercise_path(exercise), method: :delete,
                data: { turbo_confirm: session_count.zero? ? "Delete this exercise?" :
                  "Delete this exercise? This will also delete #{pluralize(session_count, "logged session")} and all their sets. This cannot be undone." },
                class: "text-sm font-medium text-crimson hover:text-crimson/80" %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
