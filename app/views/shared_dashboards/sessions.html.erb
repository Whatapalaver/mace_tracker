<% content_for :title, "Warrior Tracker - Shared Session History" %>
<% content_for :main_class, "max-w-md sm:max-w-xl md:max-w-2xl lg:max-w-5xl xl:max-w-6xl" %>

<h1 class="mb-1 text-2xl font-semibold tracking-tight">Session history</h1>
<p class="mb-4 text-sm text-muted"><%= @share_link.description %></p>

<%= render "sessions/history", url: shared_dashboard_sessions_path(@share_link.token), read_only: true %>
