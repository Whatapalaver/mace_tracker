<% content_for :title, "New Share Link" %>

<h1 class="mb-4 text-xl font-semibold">New Share Link</h1>

<%= form_with model: @share_link, url: share_links_path, class: "space-y-4" do |form| %>
  <% if @share_link.errors.any? %>
    <div class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-800">
      <ul>
        <% @share_link.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :exercise_id, "Exercise (optional)", class: "mb-1 block text-sm font-medium" %>
    <%= form.collection_select :exercise_id, @exercises, :id, :name,
          { include_blank: "All exercises" }, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
  </div>

  <div>
    <%= form.label :expires_at, "Expires (optional)", class: "mb-1 block text-sm font-medium" %>
    <%= form.date_field :expires_at, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
  </div>

  <%= form.submit "Create link", class: "w-full rounded-md bg-blue-600 py-3 text-base font-medium text-white" %>
<% end %>
