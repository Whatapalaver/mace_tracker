<%= turbo_frame_tag dom_id(session_set) do %>
  <%= form_with model: session_set, url: session_set_path(session_set), method: :patch,
        class: "border-b border-border bg-rust-light px-3 py-2 text-sm last:border-b-0" do |form| %>
    <% if session_set.errors.any? %>
      <p class="mb-2 text-xs text-crimson"><%= session_set.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="grid grid-cols-8 items-center gap-2">
      <div>
        <%= date_field_tag :date, session_set.session.date, class: "w-full rounded border border-border px-1 py-0.5 text-sm" %>
      </div>
      <div class="text-muted"><%= session_set.session.exercise.display_name %></div>
      <div class="text-muted"><%= session_set.session.session_shape.label %></div>
      <div>
        <%= form.number_field :reps, class: "w-full rounded border border-border px-1 py-0.5 text-sm" %>
      </div>
      <div>
        <%= form.number_field :weight_kg, step: 0.5, value: session_set.effective_weight_kg,
              class: "w-full rounded border border-border px-1 py-0.5 text-sm" %>
      </div>
      <div>
        <%= form.number_field :duration_seconds, value: session_set.effective_duration_seconds,
              class: "w-full rounded border border-border px-1 py-0.5 text-sm" %>
      </div>
      <div>
        <%= form.number_field :rest_seconds_actual, value: session_set.effective_rest_seconds_actual,
              class: "w-full rounded border border-border px-1 py-0.5 text-sm" %>
      </div>
      <div class="flex gap-3">
        <%= form.submit "Save", class: "font-medium text-rust hover:text-rust-dark" %>
        <%= link_to "Cancel", session_set_path(session_set), class: "font-medium text-muted" %>
      </div>
    </div>
  <% end %>
<% end %>
