<%= turbo_frame_tag dom_id(session_set) do %>
  <div class="grid grid-cols-8 items-center gap-2 border-b border-border px-3 py-2 text-sm last:border-b-0">
    <div class="text-muted"><%= session_set.session.date.to_fs(:short) %></div>
    <div><%= session_set.session.exercise.display_name %></div>
    <div class="text-muted"><%= session_set.session.session_shape.label %></div>
    <div class="font-mono"><%= session_set.reps %></div>
    <div class="font-mono"><%= session_set.effective_weight_kg %></div>
    <div class="font-mono"><%= session_set.duration_seconds %></div>
    <div class="font-mono"><%= session_set.rest_seconds_actual %></div>
    <div class="flex gap-3">
      <%= link_to "Edit", edit_session_set_path(session_set), class: "font-medium text-rust hover:text-rust-dark" %>
      <%= button_to "Delete", session_set_path(session_set), method: :delete,
            data: { turbo_confirm: "Delete this set? If it's the session's only set, the whole session is deleted.",
                     turbo_frame: "_top" },
            class: "font-medium text-crimson hover:text-crimson/80" %>
    </div>
  </div>
<% end %>
