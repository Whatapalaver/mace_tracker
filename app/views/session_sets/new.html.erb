<% content_for :title, "Log Set" %>

<h1 class="mb-1 text-xl font-semibold">Log Set</h1>
<p class="mb-4 text-sm text-gray-500"><%= @session.exercise.name %> - <%= @session.date.to_fs(:long) %></p>

<%= form_with model: @session_set, url: session_session_sets_path(@session), class: "space-y-4" do |form| %>
  <% if @session_set.errors.any? %>
    <div class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-800">
      <ul>
        <% @session_set.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :reps, class: "mb-1 block text-sm font-medium" %>
    <%= form.number_field :reps, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
  </div>

  <div>
    <%= form.label :weight_kg, "Weight override (kg, optional)", class: "mb-1 block text-sm font-medium" %>
    <%= form.number_field :weight_kg, step: 0.5, placeholder: @session.planned_weight_kg, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= form.label :duration_seconds, "Actual work (sec)", class: "mb-1 block text-sm font-medium" %>
      <%= form.number_field :duration_seconds, placeholder: @session.planned_work_seconds, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>
    <div>
      <%= form.label :rest_seconds_actual, "Actual rest (sec)", class: "mb-1 block text-sm font-medium" %>
      <%= form.number_field :rest_seconds_actual, placeholder: @session.planned_rest_seconds, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>
  </div>

  <%= form.submit "Save set", class: "w-full rounded-md bg-blue-600 py-3 text-base font-medium text-white" %>
<% end %>
