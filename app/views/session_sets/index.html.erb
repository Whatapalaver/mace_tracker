<% content_for :title, "Session History" %>

<h1 class="mb-1 text-2xl font-semibold tracking-tight">Session history</h1>
<p class="mb-4 text-sm text-muted"><%= @total_count %> sets logged.</p>

<% if @session_sets.empty? %>
  <p class="text-sm text-muted">No sessions logged yet.</p>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-border bg-surface">
    <div class="min-w-[46rem]">
      <div class="grid grid-cols-8 gap-2 border-b border-border bg-paper px-3 py-2 text-xs font-semibold tracking-widest text-muted uppercase">
        <div>Date</div>
        <div>Exercise</div>
        <div>Shape</div>
        <div>Reps</div>
        <div>Weight</div>
        <div>Work (s)</div>
        <div>Rest (s)</div>
        <div>Actions</div>
      </div>
      <% @session_sets.each do |session_set| %>
        <%= render "row", session_set: session_set %>
      <% end %>
    </div>
  </div>

  <% if @total_pages > 1 %>
    <nav class="mt-4 flex items-center justify-between text-sm">
      <% if @page > 1 %>
        <%= link_to "← Previous", session_sets_path(page: @page - 1), class: "font-medium text-rust hover:text-rust-dark" %>
      <% else %>
        <span class="text-muted/50">← Previous</span>
      <% end %>
      <span class="text-muted">Page <%= @page %> of <%= @total_pages %></span>
      <% if @page < @total_pages %>
        <%= link_to "Next →", session_sets_path(page: @page + 1), class: "font-medium text-rust hover:text-rust-dark" %>
      <% else %>
        <span class="text-muted/50">Next →</span>
      <% end %>
    </nav>
  <% end %>
<% end %>
