<% content_for :title, "#{@session.exercise.display_name} - #{@session.date}" %>

<h1 class="mb-1 text-2xl font-semibold tracking-tight"><%= @session.exercise.display_name %></h1>
<p class="mb-4 text-sm text-muted">
  <%= @session.date.to_fs(:long) %>
  <% if @session.is_benchmark? %>
    <span class="ml-2 rounded-full bg-brass-light px-2 py-0.5 text-xs font-semibold tracking-wide text-brass uppercase">Benchmark</span>
  <% end %>
</p>

<div class="mb-6 rounded-md bg-ink px-3 py-3 font-mono text-lg tracking-wide text-paper">
  <% if @session.session_shape.name == SessionShape::INTERVAL_WORK %>
    <%= Progression::IntervalFormula.render(@session) %>
  <% else %>
    <%= Progression::RepsFormula.render(count: @session.session_sets.size,
          reps: @session.reps || @session.reps_per_minute, weight_kg: @session.weight_kg) %>
  <% end %>
</div>

<%= render SessionOutputsComponent.new(calculator: @calculator) %>

<p class="mb-6 text-sm">
  <%= link_to "View progression for this signature →",
        stats_path(exercise_id: @session.exercise_id, shape: @session.session_shape.name,
                    structural_value: @session.structural_value),
        class: "font-medium text-rust hover:text-rust-dark" %>
</p>

<section class="mb-6">
  <h2 class="mb-2 text-xs font-semibold tracking-widest text-muted uppercase">Sets</h2>

  <% if @session.session_sets.empty? %>
    <p class="text-sm text-muted">No sets logged.</p>
  <% else %>
    <ul class="divide-y divide-border rounded-lg border border-border bg-surface">
      <% @session.session_sets.order(:set_number).each do |session_set| %>
        <li class="flex items-center justify-between px-4 py-3 text-sm">
          <span class="text-muted">Set <%= session_set.set_number %></span>
          <span class="font-mono">
            <%= session_set.reps %> reps<% if session_set.duration_seconds %> / <%= session_set.duration_seconds %>s<% end %> @ <%= session_set.effective_weight_kg %>kg
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<%= button_to "Delete session", session_path(@session), method: :delete,
      data: { turbo_confirm: "Delete this whole session and all its sets?" },
      class: "font-medium text-crimson hover:text-crimson/80" %>
