<% content_for :title, "#{@session.exercise.name} - #{@session.date}" %>

<h1 class="mb-1 text-xl font-semibold"><%= @session.exercise.name %></h1>
<p class="mb-4 text-sm text-gray-500">
  <%= @session.date.to_fs(:long) %>
  <% if @session.is_benchmark? %>
    <span class="ml-2 rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800">Benchmark</span>
  <% end %>
</p>

<section class="mb-6 rounded-lg border border-gray-200 bg-white p-4 text-sm">
  <dl class="grid grid-cols-2 gap-2">
    <dt class="text-gray-500">Weight</dt>
    <dd><%= @session.planned_weight_kg %> kg</dd>
    <% case @session.session_shape.name %>
    <% when SessionShape::INTERVAL_WORK %>
      <dt class="text-gray-500">Work / Rest</dt>
      <dd><%= @session.planned_work_seconds %>s / <%= @session.planned_rest_seconds %>s</dd>
      <dt class="text-gray-500">Sets</dt>
      <dd><%= @session.planned_sets %></dd>
    <% when SessionShape::FIXED_REPS_FOR_TIME %>
      <dt class="text-gray-500">Target reps</dt>
      <dd><%= @session.target_reps %></dd>
    <% when SessionShape::EMOM %>
      <dt class="text-gray-500">Target reps / min</dt>
      <dd><%= @session.target_reps_per_minute %></dd>
    <% end %>
  </dl>
</section>

<%= render SessionOutputsComponent.new(calculator: @calculator) %>

<p class="mb-6 text-sm">
  <%= link_to "View progression for this signature →",
        stats_path(exercise_id: @session.exercise_id, shape: @session.session_shape.name,
                    structural_value: @session.structural_value),
        class: "font-medium text-blue-600" %>
</p>

<section class="mb-6">
  <h2 class="mb-2 font-semibold">Sets</h2>

  <% if @session.session_sets.empty? %>
    <p class="text-sm text-gray-500">No sets logged.</p>
  <% else %>
    <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
      <% @session.session_sets.order(:set_number).each do |session_set| %>
        <li class="flex items-center justify-between px-4 py-3 text-sm">
          <span>Set <%= session_set.set_number %></span>
          <span>
            <%= session_set.reps %> reps
            <% if session_set.duration_seconds %> in <%= session_set.duration_seconds %>s<% end %>
            @ <%= session_set.effective_weight_kg %> kg
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
