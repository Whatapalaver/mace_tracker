<% content_for :title, "#{@session.exercise.name} - #{@session.date}" %>

<h1 class="mb-1 text-xl font-semibold"><%= @session.exercise.name %></h1>
<p class="mb-4 text-sm text-gray-500"><%= @session.date.to_fs(:long) %></p>

<section class="mb-6 rounded-lg border border-gray-200 bg-white p-4 text-sm">
  <dl class="grid grid-cols-2 gap-2">
    <dt class="text-gray-500">Weight</dt>
    <dd><%= @session.planned_weight_kg %> kg</dd>
    <dt class="text-gray-500">Work / Rest</dt>
    <dd><%= @session.planned_work_seconds %>s / <%= @session.planned_rest_seconds %>s</dd>
    <dt class="text-gray-500">Planned sets</dt>
    <dd><%= @session.planned_sets %></dd>
  </dl>
</section>

<section class="mb-6 rounded-lg border border-gray-200 bg-white p-4 text-sm">
  <h2 class="mb-2 font-semibold">Outputs</h2>
  <dl class="grid grid-cols-2 gap-2">
    <dt class="text-gray-500">Best pace</dt>
    <dd><%= number_with_precision(@calculator.best_pace, precision: 3) if @calculator.best_pace %></dd>
    <dt class="text-gray-500">Avg pace</dt>
    <dd><%= number_with_precision(@calculator.avg_pace, precision: 3) if @calculator.avg_pace %></dd>
    <dt class="text-gray-500">Total output</dt>
    <dd><%= @calculator.total_session_output %></dd>
    <dt class="text-gray-500">Output / total time</dt>
    <dd><%= number_with_precision(@calculator.output_per_total_time, precision: 3) if @calculator.output_per_total_time %></dd>
    <dt class="text-gray-500">Output / working time</dt>
    <dd><%= number_with_precision(@calculator.output_per_working_time, precision: 3) if @calculator.output_per_working_time %></dd>
  </dl>
</section>

<section class="mb-6">
  <div class="mb-2 flex items-center justify-between">
    <h2 class="font-semibold">Sets</h2>
    <%= link_to "Log set", new_session_session_set_path(@session), class: "text-sm font-medium text-blue-600" %>
  </div>

  <% if @session.session_sets.empty? %>
    <p class="text-sm text-gray-500">No sets logged yet.</p>
  <% else %>
    <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
      <% @session.session_sets.order(:set_number).each do |session_set| %>
        <li class="flex items-center justify-between px-4 py-3 text-sm">
          <span>Set <%= session_set.set_number %></span>
          <span><%= session_set.reps %> reps @ <%= session_set.effective_weight_kg %> kg</span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
