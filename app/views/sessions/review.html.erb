<% content_for :title, "Confirm Session" %>

<h1 class="mb-1 text-2xl font-semibold tracking-tight"><%= @session.exercise.display_name %></h1>
<p class="mb-4 text-sm text-muted"><%= @session.date.to_fs(:long) %></p>

<div class="mb-6 rounded-md bg-ink px-3 py-3 font-mono text-lg tracking-wide text-paper">
  <% if @session.session_shape.name == SessionShape::INTERVAL_WORK %>
    <%= Progression::IntervalFormula.render(@session) %>
  <% else %>
    <%= Progression::RepsFormula.render(count: @session.session_sets.size,
          reps: @session.reps || @session.reps_per_minute, weight_kg: @session.weight_kg) %>
  <% end %>
</div>

<%= form_with model: @session, url: sessions_path, class: "space-y-5", data: { turbo: false } do |form| %>
  <% if @session.errors.any? %>
    <div class="rounded-md border border-crimson/20 bg-crimson-light px-3 py-2 text-sm text-crimson">
      <ul class="list-inside list-disc">
        <% @session.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :date %>
  <%= form.hidden_field :exercise_id %>
  <%= form.hidden_field :session_shape_id %>
  <%= form.hidden_field :benchmark_preset_id %>
  <%= form.hidden_field :is_benchmark %>
  <%= form.hidden_field :weight_kg %>
  <%= form.hidden_field :work_seconds %>
  <%= form.hidden_field :rest_seconds %>
  <%= form.hidden_field :sets_count %>
  <%= form.hidden_field :reps %>
  <%= form.hidden_field :notes %>

  <% if @matching_preset %>
    <label class="flex items-center gap-2 rounded-md border border-brass/30 bg-brass-light px-3 py-2 text-sm text-brass">
      <%= check_box_tag "session[benchmark_preset_id]", @matching_preset.id, false, class: "accent-brass" %>
      Matches preset "<%= @matching_preset.name %>" — mark as benchmark?
    </label>
  <% end %>

  <fieldset class="space-y-2" data-controller="fill-down">
    <legend class="mb-1 text-xs font-semibold tracking-widest text-muted uppercase">Sets</legend>
    <% if @session.session_sets.size > 1 %>
      <p class="text-xs text-muted">Tip: enter the first set's reps and the rest will fill in to match — still editable individually.</p>
    <% end %>
    <%= form.fields_for :session_sets do |set_form| %>
      <% reps_data = set_form.index.zero? ? { fill_down_target: "source field", action: "change->fill-down#fill" } : { fill_down_target: "field" } %>
      <div class="rounded-md border border-border bg-surface p-3">
        <%= set_form.hidden_field :set_number %>
        <% if @session.session_shape.name == SessionShape::INTERVAL_WORK %>
          <%= set_form.hidden_field :duration_seconds %>
          <div class="flex items-center justify-between gap-3">
            <span class="text-sm text-muted">
              Set <%= set_form.object.set_number %> <span class="font-mono">(<%= set_form.object.duration_seconds %>s)</span>
            </span>
            <%= set_form.label :reps, "Reps", class: "sr-only" %>
            <%= set_form.number_field :reps, data: reps_data, class: "w-24 rounded-md border border-border bg-surface px-2 py-1 text-base" %>
          </div>
        <% elsif @session.session_shape.name == SessionShape::SETS_AND_REPS %>
          <div class="flex items-center justify-between gap-3">
            <span class="text-sm text-muted">Set <%= set_form.object.set_number %></span>
            <%= set_form.label :reps, "Reps", class: "sr-only" %>
            <%= set_form.number_field :reps, data: reps_data, class: "w-24 rounded-md border border-border bg-surface px-2 py-1 text-base" %>
          </div>
        <% else %>
          <div class="flex items-center justify-between gap-3">
            <span class="text-sm text-muted">Set <%= set_form.object.set_number %></span>
            <%= set_form.label :reps, "Reps", class: "sr-only" %>
            <%= set_form.number_field :reps, data: reps_data, class: "w-20 rounded-md border border-border bg-surface px-2 py-1 text-base" %>
            <%= set_form.label :duration_seconds, "Seconds", class: "sr-only" %>
            <%= set_form.number_field :duration_seconds, placeholder: "seconds",
                  class: "w-24 rounded-md border border-border bg-surface px-2 py-1 text-base" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </fieldset>

  <%= form.submit "Save session", class: "w-full rounded-md bg-rust py-3 text-base font-semibold text-paper transition-colors hover:bg-rust-dark" %>
<% end %>
