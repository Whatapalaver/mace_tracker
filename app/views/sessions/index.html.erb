<% content_for :title, "Session History" %>
<% content_for :main_class, "max-w-md sm:max-w-xl md:max-w-2xl lg:max-w-5xl xl:max-w-6xl" %>

<h1 class="mb-1 text-2xl font-semibold tracking-tight">Session history</h1>
<p class="mb-4 text-sm text-muted"><%= @total_count %> sessions logged.</p>

<% if @years.any? %>
  <%= form_with url: sessions_path, method: :get, class: "mb-4 grid grid-cols-2 gap-3", data: { turbo: false } do %>
    <div>
      <%= label_tag :year, "Year", class: "mb-1 block text-sm font-medium" %>
      <%= select_tag :year, options_for_select(@years, @year),
            include_blank: "All years",
            class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base", onchange: "this.form.requestSubmit()" %>
    </div>
    <% if @year %>
      <div>
        <%= label_tag :month, "Month", class: "mb-1 block text-sm font-medium" %>
        <%= select_tag :month,
              options_for_select(@months.map { |m| [ Date::MONTHNAMES[m], m ] }, @month),
              include_blank: "All months",
              class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base", onchange: "this.form.requestSubmit()" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if @sessions.empty? %>
  <p class="text-sm text-muted">
    <%= @years.empty? ? "No sessions logged yet." : "No sessions match the selected year/month." %>
  </p>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-border bg-surface">
    <div class="lg:min-w-[60rem]">
      <div class="hidden grid-cols-9 gap-2 border-b border-border bg-paper px-3 py-2 text-xs font-semibold tracking-widest text-muted uppercase lg:grid">
        <div>Date</div>
        <div>Exercise</div>
        <div>Shape</div>
        <div>Signature</div>
        <div>Weight</div>
        <div>Reps</div>
        <div>Benchmark</div>
        <div>Notes</div>
        <div>Actions</div>
      </div>
      <% @sessions.each do |session| %>
        <%= render "row", session: session %>
      <% end %>
    </div>
  </div>

  <% if @total_pages > 1 %>
    <nav class="mt-4 flex items-center justify-between text-sm">
      <% if @page > 1 %>
        <%= link_to "← Previous", sessions_path(page: @page - 1, year: @year, month: @month), class: "font-medium text-rust hover:text-rust-dark" %>
      <% else %>
        <span class="text-muted/50">← Previous</span>
      <% end %>
      <span class="text-muted">Page <%= @page %> of <%= @total_pages %></span>
      <% if @page < @total_pages %>
        <%= link_to "Next →", sessions_path(page: @page + 1, year: @year, month: @month), class: "font-medium text-rust hover:text-rust-dark" %>
      <% else %>
        <span class="text-muted/50">Next →</span>
      <% end %>
    </nav>
  <% end %>
<% end %>
