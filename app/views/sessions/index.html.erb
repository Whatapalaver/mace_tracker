<% content_for :title, "Session History" %>
<% content_for :main_class, "max-w-md sm:max-w-xl md:max-w-2xl lg:max-w-5xl xl:max-w-6xl" %>

<h1 class="mb-1 text-2xl font-semibold tracking-tight">Session history</h1>
<p class="mb-4 text-sm text-muted"><%= @total_count %> sessions logged.</p>

<% if @sessions.empty? %>
  <p class="text-sm text-muted">No sessions logged yet.</p>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-border bg-surface">
    <div class="min-w-[60rem]">
      <div class="grid grid-cols-8 gap-2 border-b border-border bg-paper px-3 py-2 text-xs font-semibold tracking-widest text-muted uppercase">
        <div>Date</div>
        <div>Exercise</div>
        <div>Signature</div>
        <div>Weight</div>
        <div>Reps</div>
        <div>Benchmark</div>
        <div>Notes</div>
        <div>Actions</div>
      </div>
      <% @sessions.each do |session| %>
        <%= render "row", session: session %>
      <% end %>
    </div>
  </div>

  <% if @total_pages > 1 %>
    <nav class="mt-4 flex items-center justify-between text-sm">
      <% if @page > 1 %>
        <%= link_to "← Previous", sessions_path(page: @page - 1), class: "font-medium text-rust hover:text-rust-dark" %>
      <% else %>
        <span class="text-muted/50">← Previous</span>
      <% end %>
      <span class="text-muted">Page <%= @page %> of <%= @total_pages %></span>
      <% if @page < @total_pages %>
        <%= link_to "Next →", sessions_path(page: @page + 1), class: "font-medium text-rust hover:text-rust-dark" %>
      <% else %>
        <span class="text-muted/50">Next →</span>
      <% end %>
    </nav>
  <% end %>
<% end %>
