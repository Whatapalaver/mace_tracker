<% content_for :title, "Log Session" %>

<h1 class="mb-4 text-xl font-semibold">Log Session</h1>

<% if @session.benchmark_preset_id.present? %>
  <p class="mb-4 rounded-md bg-blue-50 px-3 py-2 text-sm text-blue-800">
    Starting from benchmark preset: <%= BenchmarkPreset.find(@session.benchmark_preset_id).name %>
  </p>
<% end %>

<% if @exercises.empty? %>
  <p class="text-sm text-gray-500">
    You need an exercise before logging a session.
    <%= link_to "Add one", new_exercise_path, class: "text-blue-600" %>.
  </p>
<% else %>
  <%= form_with model: @session, class: "space-y-4", data: { controller: "shape-form" } do |form| %>
    <% if @session.errors.any? %>
      <div class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-800">
        <ul>
          <% @session.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :benchmark_preset_id %>

    <div>
      <%= form.label :exercise_id, "Exercise", class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :exercise_id, @exercises, :id, :name, {}, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <div>
      <%= form.label :date, class: "mb-1 block text-sm font-medium" %>
      <%= form.date_field :date, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <%= render "shared/shape_fields", form: form, session_shapes: @session_shapes %>

    <div>
      <%= form.label :notes, class: "mb-1 block text-sm font-medium" %>
      <%= form.text_area :notes, rows: 2, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <%= form.submit "Start session", class: "w-full rounded-md bg-blue-600 py-3 text-base font-medium text-white" %>
  <% end %>
<% end %>
