<% content_for :title, "Log Session" %>

<h1 class="mb-1 text-2xl font-semibold tracking-tight">Log session</h1>
<p class="mb-6 text-sm text-muted">Enter the formula for what you did — sets get built from it.</p>

<% if @session.benchmark_preset_id.present? %>
  <p class="mb-4 rounded-md border border-brass/30 bg-brass-light px-3 py-2 text-sm text-brass">
    Starting from benchmark preset: <strong><%= BenchmarkPreset.find(@session.benchmark_preset_id).name %></strong>
  </p>
<% end %>

<% if @exercises.empty? %>
  <p class="text-sm text-muted">
    You need an exercise before logging a session.
    <%= link_to "Add one", new_exercise_path, class: "font-medium text-rust" %>.
  </p>
<% else %>
  <%= form_with model: @session, url: sessions_path, class: "space-y-5", data: { turbo: false } do |form| %>
    <% if @session.errors.any? %>
      <div class="rounded-md border border-crimson/20 bg-crimson-light px-3 py-2 text-sm text-crimson">
        <ul class="list-inside list-disc">
          <% @session.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :benchmark_preset_id %>

    <% if @benchmark_presets.any? %>
      <div>
        <%= label_tag :preset_picker, "Start from a saved preset", class: "mb-1 block text-sm font-medium" %>
        <%= select_tag :preset_picker,
              options_for_select(
                @benchmark_presets.map { |preset| [ "#{preset.name} (#{preset.exercise.display_name})", preset.id ] },
                @session.benchmark_preset_id
              ),
              include_blank: "None",
              onchange: "if (this.value) { window.location = #{new_session_path.to_json} + '?benchmark_preset_id=' + this.value }",
              class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base" %>
      </div>
    <% end %>

    <div>
      <%= form.label :exercise_id, "Exercise", class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :exercise_id, @exercises, :id, :display_name, {},
            class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base" %>
    </div>

    <div>
      <%= form.label :date, class: "mb-1 block text-sm font-medium" %>
      <%= form.date_field :date, class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base" %>
    </div>

    <fieldset>
      <legend class="mb-1 text-sm font-medium">Shape</legend>
      <div class="space-y-2">
        <% @session_shapes.each do |shape| %>
          <label class="flex items-center gap-2 rounded-md border border-border px-3 py-2 has-[:checked]:border-rust has-[:checked]:bg-rust-light">
            <%= form.radio_button :session_shape_id, shape.id,
                  class: "accent-rust",
                  checked: form.object.session_shape_id == shape.id ||
                    (form.object.session_shape_id.nil? && shape.name == SessionShape::INTERVAL_WORK) %>
            <%= shape.label %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div>
      <%= form.label :formula, "Formula", class: "mb-1 block text-xs font-semibold tracking-widest text-muted uppercase" %>
      <%= form.text_field :formula, placeholder: "5(5mw+5mr)@10kg",
            class: "w-full rounded-md border border-ink bg-ink px-3 py-3 font-mono text-lg tracking-wide text-paper placeholder-paper/30 focus:outline-none focus:ring-2 focus:ring-rust" %>
      <p class="mt-2 text-xs text-muted">
        Interval work: <code class="font-mono text-ink">N(Xmw+Ymr)@Wkg</code> — e.g. <code class="font-mono text-ink">5(5mw+5mr)@10kg</code>.
        Fixed reps for time / EMOM: <code class="font-mono text-ink">N(X@Wkg)</code> — e.g. <code class="font-mono text-ink">5(108@10kg)</code>.
      </p>
    </div>

    <label class="flex items-center gap-2 rounded-md border border-border px-3 py-2 text-sm font-medium has-[:checked]:border-brass has-[:checked]:bg-brass-light">
      <%= form.check_box :is_benchmark, class: "accent-brass" %>
      This was an all-out benchmark effort
    </label>

    <div>
      <%= form.label :notes, class: "mb-1 block text-sm font-medium" %>
      <%= form.text_area :notes, rows: 2, class: "w-full rounded-md border border-border bg-surface px-3 py-2 text-base" %>
    </div>

    <%= form.submit "Continue", class: "w-full rounded-md bg-rust py-3 text-base font-semibold text-paper transition-colors hover:bg-rust-dark" %>
  <% end %>
<% end %>
