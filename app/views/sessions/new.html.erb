<% content_for :title, "Log Session" %>

<h1 class="mb-4 text-xl font-semibold">Log Session</h1>

<% if @exercises.empty? %>
  <p class="text-sm text-gray-500">
    You need an exercise before logging a session.
    <%= link_to "Add one", new_exercise_path, class: "text-blue-600" %>.
  </p>
<% else %>
  <%= form_with model: @session, class: "space-y-4", data: { controller: "shape-form" } do |form| %>
    <% if @session.errors.any? %>
      <div class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-800">
        <ul>
          <% @session.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :exercise_id, "Exercise", class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :exercise_id, @exercises, :id, :name, {}, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <div>
      <%= form.label :date, class: "mb-1 block text-sm font-medium" %>
      <%= form.date_field :date, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <fieldset>
      <legend class="mb-1 text-sm font-medium">Shape</legend>
      <div class="space-y-2">
        <% @session_shapes.each do |shape| %>
          <label class="flex items-center gap-2 rounded-md border border-gray-300 px-3 py-2">
            <%= form.radio_button :session_shape_id, shape.id,
                  checked: @session.session_shape_id == shape.id || (@session.session_shape_id.nil? && shape.name == SessionShape::INTERVAL_WORK),
                  data: { shape_form_target: "shapeInput", shape_name: shape.name, action: "change->shape-form#toggle" } %>
            <%= shape.label %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div>
      <%= form.label :planned_weight_kg, "Weight (kg)", class: "mb-1 block text-sm font-medium" %>
      <%= form.number_field :planned_weight_kg, step: 0.5, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <div data-shape-form-target="group" data-allowed-shapes="interval_work" class="grid grid-cols-3 gap-3">
      <div>
        <%= form.label :planned_work_seconds, "Work (sec)", class: "mb-1 block text-sm font-medium" %>
        <%= form.number_field :planned_work_seconds, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
      </div>
      <div>
        <%= form.label :planned_rest_seconds, "Rest (sec)", class: "mb-1 block text-sm font-medium" %>
        <%= form.number_field :planned_rest_seconds, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
      </div>
      <div>
        <%= form.label :planned_sets, "Sets", class: "mb-1 block text-sm font-medium" %>
        <%= form.number_field :planned_sets, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
      </div>
    </div>

    <div data-shape-form-target="group" data-allowed-shapes="fixed_reps_for_time">
      <%= form.label :target_reps, "Target reps", class: "mb-1 block text-sm font-medium" %>
      <%= form.number_field :target_reps, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <div data-shape-form-target="group" data-allowed-shapes="emom">
      <%= form.label :target_reps_per_minute, "Target reps / min", class: "mb-1 block text-sm font-medium" %>
      <%= form.number_field :target_reps_per_minute, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <div>
      <%= form.label :notes, class: "mb-1 block text-sm font-medium" %>
      <%= form.text_area :notes, rows: 2, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <%= form.submit "Start session", class: "w-full rounded-md bg-blue-600 py-3 text-base font-medium text-white" %>
  <% end %>
<% end %>
