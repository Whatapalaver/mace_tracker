<% content_for :title, "Log Session" %>

<h1 class="mb-4 text-xl font-semibold">Log Session</h1>

<% if @session.benchmark_preset_id.present? %>
  <p class="mb-4 rounded-md bg-blue-50 px-3 py-2 text-sm text-blue-800">
    Starting from benchmark preset: <%= BenchmarkPreset.find(@session.benchmark_preset_id).name %>
  </p>
<% end %>

<% if @exercises.empty? %>
  <p class="text-sm text-gray-500">
    You need an exercise before logging a session.
    <%= link_to "Add one", new_exercise_path, class: "text-blue-600" %>.
  </p>
<% else %>
  <%= form_with model: @session, url: sessions_path, class: "space-y-4", data: { turbo: false } do |form| %>
    <% if @session.errors.any? %>
      <div class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-800">
        <ul>
          <% @session.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :benchmark_preset_id %>

    <% if @benchmark_presets.any? %>
      <div>
        <%= label_tag :preset_picker, "Start from a saved preset", class: "mb-1 block text-sm font-medium" %>
        <%= select_tag :preset_picker,
              options_for_select(
                @benchmark_presets.map { |preset| [ "#{preset.name} (#{preset.exercise.name})", preset.id ] },
                @session.benchmark_preset_id
              ),
              include_blank: "None",
              onchange: "if (this.value) { window.location = #{new_session_path.to_json} + '?benchmark_preset_id=' + this.value }",
              class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
      </div>
    <% end %>

    <div>
      <%= form.label :exercise_id, "Exercise", class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :exercise_id, @exercises, :id, :name, {}, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <div>
      <%= form.label :date, class: "mb-1 block text-sm font-medium" %>
      <%= form.date_field :date, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <fieldset>
      <legend class="mb-1 text-sm font-medium">Shape</legend>
      <div class="space-y-2">
        <% @session_shapes.each do |shape| %>
          <label class="flex items-center gap-2 rounded-md border border-gray-300 px-3 py-2">
            <%= form.radio_button :session_shape_id, shape.id,
                  checked: form.object.session_shape_id == shape.id ||
                    (form.object.session_shape_id.nil? && shape.name == SessionShape::INTERVAL_WORK) %>
            <%= shape.label %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div>
      <%= form.label :formula, class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :formula, placeholder: "5(5mw+5mr)@10kg",
            class: "w-full rounded-md border-gray-300 px-3 py-2 font-mono text-base" %>
      <p class="mt-1 text-xs text-gray-500">
        Interval work: <code>N(Xmw+Ymr)@Wkg</code> — e.g. <code>5(5mw+5mr)@10kg</code>.
        Fixed reps for time / EMOM: <code>N(X@Wkg)</code> — e.g. <code>5(108@10kg)</code>.
      </p>
    </div>

    <div>
      <label class="flex items-center gap-2 text-sm font-medium">
        <%= form.check_box :is_benchmark %>
        This was an all-out benchmark effort
      </label>
    </div>

    <div>
      <%= form.label :notes, class: "mb-1 block text-sm font-medium" %>
      <%= form.text_area :notes, rows: 2, class: "w-full rounded-md border-gray-300 px-3 py-2 text-base" %>
    </div>

    <%= form.submit "Continue", class: "w-full rounded-md bg-blue-600 py-3 text-base font-medium text-white" %>
  <% end %>
<% end %>
