<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Warrior Tracker - Shared Progress" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    <header class="border-b border-border bg-surface px-4 py-3">
      <div class="mx-auto flex max-w-md items-center gap-3 sm:max-w-xl md:max-w-2xl lg:max-w-5xl xl:max-w-6xl">
        <span class="flex h-7 w-7 items-center justify-center rounded bg-ink font-mono text-sm font-semibold text-paper">W</span>
        <span class="text-base font-semibold tracking-tight">Warrior Tracker</span>
        <span class="text-sm text-muted">— shared, read-only</span>
        <nav class="ml-auto flex gap-4 text-sm">
          <%= link_to "Stats", shared_dashboard_path(@share_link.token), class: "text-muted transition-colors hover:text-rust" %>
          <%= link_to "History", shared_dashboard_sessions_path(@share_link.token), class: "text-muted transition-colors hover:text-rust" %>
        </nav>
      </div>
    </header>

    <main class="mx-auto px-4 py-6 <%= content_for(:main_class).presence || "max-w-md sm:max-w-xl md:max-w-2xl" %>">
      <%= yield %>
    </main>
  </body>
</html>
